      "css": ":host{--brand:#9d202e;--brand-hover:#7c1823;--brand-tint:oklch(95.5% 0.018 18);--brand-tint-2:oklch(90.5% 0.042 18);--desk:oklch(93.5% 0.006 75);--desk-deep:oklch(90% 0.008 75);--panel:oklch(98.6% 0.003 75);--paper:#fff;--ink:oklch(21% 0.006 30);--ink-2:oklch(38% 0.008 30);--ink-3:oklch(48% 0.008 30);--rule:oklch(87.5% 0.007 75);--rule-soft:oklch(92% 0.005 75);--up:oklch(45% 0.11 150);--danger:oklch(50% 0.17 27);--danger-tint:oklch(95.5% 0.03 27);--r-s:6px;--r-m:8px;--ease:cubic-bezier(0.16,1,0.3,1);font-family:'Hanken Grotesk','Segoe UI',system-ui,sans-serif;font-variant-numeric:tabular-nums;color:var(--ink);} .ds-btn{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 14px;border-radius:var(--r-s);border:1px solid var(--rule);background:var(--paper);font:600 14px 'Hanken Grotesk','Segoe UI',system-ui,sans-serif;color:var(--ink);cursor:pointer;transition:background .15s,border-color .15s,color .15s;} .ds-btn:focus-visible{outline:2px solid var(--brand);outline-offset:2px;} .ds-btn-danger{color:var(--danger);} .ds-btn-danger:hover{background:var(--danger-tint);}"
