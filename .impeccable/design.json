      "css": ":host{--brand:#9d202e;--brand-hover:#7c1823;--brand-tint:oklch(95.5% 0.018 18);--brand-tint-2:oklch(90.5% 0.042 18);--desk:oklch(93.5% 0.006 75);--desk-deep:oklch(90% 0.008 75);--panel:oklch(98.6% 0.003 75);--paper:#fff;--ink:oklch(21% 0.006 30);--ink-2:oklch(38% 0.008 30);--ink-3:oklch(48% 0.008 30);--rule:oklch(87.5% 0.007 75);--rule-soft:oklch(92% 0.005 75);--up:oklch(45% 0.11 150);--danger:oklch(50% 0.17 27);--danger-tint:oklch(95.5% 0.03 27);--r-s:6px;--r-m:8px;--ease:cubic-bezier(0.16,1,0.3,1);font-family:'Hanken Grotesk','Segoe UI',system-ui,sans-serif;font-variant-numeric:tabular-nums;color:var(--ink);} .ds-f{display:grid;gap:4px;} .ds-f span{font-size:12.5px;font-weight:600;color:var(--ink-2);} .ds-input{height:34px;padding:0 9px;border:1px solid var(--rule);border-radius:var(--r-s);background:var(--paper);font:400 14px 'Hanken Grotesk',system-ui,sans-serif;color:var(--ink);transition:border-color .15s,box-shadow .15s;} .ds-input:hover{border-color:oklch(80% 0.01 75);} .ds-input:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 3px var(--brand-tint-2);}"
