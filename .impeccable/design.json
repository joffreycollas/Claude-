      "css": ":host{--brand:#9d202e;--brand-hover:#7c1823;--brand-tint:oklch(95.5% 0.018 18);--brand-tint-2:oklch(90.5% 0.042 18);--desk:oklch(93.5% 0.006 75);--desk-deep:oklch(90% 0.008 75);--panel:oklch(98.6% 0.003 75);--paper:#fff;--ink:oklch(21% 0.006 30);--ink-2:oklch(38% 0.008 30);--ink-3:oklch(48% 0.008 30);--rule:oklch(87.5% 0.007 75);--rule-soft:oklch(92% 0.005 75);--up:oklch(45% 0.11 150);--danger:oklch(50% 0.17 27);--danger-tint:oklch(95.5% 0.03 27);--r-s:6px;--r-m:8px;--ease:cubic-bezier(0.16,1,0.3,1);font-family:'Hanken Grotesk','Segoe UI',system-ui,sans-serif;font-variant-numeric:tabular-nums;color:var(--ink);} .ds-tabs{display:flex;gap:2px;height:56px;background:var(--panel);border-bottom:1px solid var(--rule);} .ds-tab{position:relative;display:flex;align-items:center;padding:0 14px;border:0;background:none;color:var(--ink-2);font:600 14.5px 'Hanken Grotesk',system-ui,sans-serif;cursor:pointer;} .ds-tab span{margin-left:6px;font-size:12.5px;color:var(--ink-3);} .ds-tab:hover{color:var(--ink);} .ds-tab:focus-visible{outline:2px solid var(--brand);outline-offset:2px;} .ds-tab[aria-selected=true]{color:var(--brand);} .ds-tab[aria-selected=true]::after{content:'';position:absolute;left:10px;right:10px;bottom:0;height:2px;background:var(--brand);border-radius:2px 2px 0 0;}"
