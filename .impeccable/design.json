      "css": ":host{--brand:#9d202e;--brand-hover:#7c1823;--brand-tint:oklch(95.5% 0.018 18);--brand-tint-2:oklch(90.5% 0.042 18);--desk:oklch(93.5% 0.006 75);--desk-deep:oklch(90% 0.008 75);--panel:oklch(98.6% 0.003 75);--paper:#fff;--ink:oklch(21% 0.006 30);--ink-2:oklch(38% 0.008 30);--ink-3:oklch(48% 0.008 30);--rule:oklch(87.5% 0.007 75);--rule-soft:oklch(92% 0.005 75);--up:oklch(45% 0.11 150);--danger:oklch(50% 0.17 27);--danger-tint:oklch(95.5% 0.03 27);--r-s:6px;--r-m:8px;--ease:cubic-bezier(0.16,1,0.3,1);font-family:'Hanken Grotesk','Segoe UI',system-ui,sans-serif;font-variant-numeric:tabular-nums;color:var(--ink);} .ds-seg{display:flex;padding:3px;gap:3px;background:var(--desk);border-radius:var(--r-s);width:280px;} .ds-seg button{flex:1;height:28px;border:0;border-radius:5px;background:none;font:600 13px 'Hanken Grotesk',system-ui,sans-serif;color:var(--ink-2);cursor:pointer;} .ds-seg button:hover{color:var(--ink);} .ds-seg button:focus-visible{outline:2px solid var(--brand);outline-offset:1px;} .ds-seg button[aria-pressed=true]{background:var(--paper);color:var(--brand);box-shadow:0 1px 2px oklch(28% 0.01 30 / 0.14);}"
